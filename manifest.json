{
  "manifest_version": 3,
  "name": "PaceMeter — Lecture Speed Meter",
  "version": "1.1.0",
  "description": "Real-time local speech speed meter overlay for Google Meet, Zoom, Teams, and online lectures. Alerts you when speaking too fast.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PaceMeter Speed Meter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-pacemeter": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle PaceMeter floating overlay on active lecture tab"
    }
  }
}